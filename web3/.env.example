# Which deployment to read from web3/src/generated/incident-deployments.ts.
VITE_NETWORK=localhost

# Fastify API base (same JWT backend app already uses).
VITE_API_BASE_URL=http://127.0.0.1:3000/api

# Read-only RPC fallback for pages that work without a connected wallet
# (decision #11, tmp/02_decisions/2026-10-01_task5-dapp-incident-decisions.md):
# must be a public endpoint with no embedded API key, since VITE_* vars are
# inlined into the client bundle and visible to every visitor.
# Verified live 2026-10-01 (eth_chainId -> 0xaa36a7 / 11155111).
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
