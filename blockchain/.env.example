# Sepolia RPC endpoint (Infura/Alchemy/...)
SEPOLIA_RPC_URL=
# Deployer wallet private key (funded with Sepolia ETH). Never commit.
DEPLOYER_PRIVATE_KEY=
# Etherscan API key (v2, works for Sepolia) used for source verification
ETHERSCAN_API_KEY=
# DEFAULT_ADMIN_ROLE holder (multisig/ops wallet). Defaults to the deployer.
ADMIN_ADDRESS=
# Backend relayer wallet address granted RELAYER_ROLE (optional at deploy time)
RELAYER_ADDRESS=
# Device manager address granted DEVICE_MANAGER_ROLE (optional at deploy time)
DEVICE_MANAGER_ADDRESS=

# --- Incentives (scripts/deploy-incentives.js, fund-incentives.js) ---
# AirSafetyLog to read. Defaults to spec/incident/deployments/<network>.json.
AIR_SAFETY_LOG_ADDRESS=
# Receives the 1 000 000 ASAFE and 50% of every penalty. Defaults to ADMIN_ADDRESS.
TREASURY_ADDRESS=
# Operator whose bond P2 slashes. Defaults to RELAYER_ADDRESS, then the
# RELAYER_ROLE grant recorded in deployments/<network>.json.
OPERATOR_ADDRESS=
# Targets topped up by fund-incentives.js (whole ASAFE).
REWARD_FUND_ASAFE=50000
OPERATOR_BOND_ASAFE=1000
