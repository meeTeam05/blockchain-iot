# Sepolia RPC endpoint (Infura/Alchemy/...)
SEPOLIA_RPC_URL=
# Deployer wallet private key (funded with Sepolia ETH). Never commit.
DEPLOYER_PRIVATE_KEY=
# Etherscan API key (v2, works for Sepolia) used for source verification
ETHERSCAN_API_KEY=
# DEFAULT_ADMIN_ROLE holder (multisig/ops wallet). Defaults to the deployer.
ADMIN_ADDRESS=
# Backend relayer wallet address granted RELAYER_ROLE (optional at deploy time)
RELAYER_ADDRESS=
# Device manager address granted DEVICE_MANAGER_ROLE (optional at deploy time)
DEVICE_MANAGER_ADDRESS=
