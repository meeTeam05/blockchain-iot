# PostgreSQL
POSTGRES_DB=smartair
POSTGRES_USER=smartair
POSTGRES_PASSWORD=changeme_strong_password_here

# Redis
REDIS_PASSWORD=changeme_redis_password_here

# EMQX
EMQX_DASHBOARD_PASSWORD=changeme_emqx_dashboard_password
EMQX_API_KEY=smart-air-api
EMQX_API_SECRET=generate_with_openssl_rand_hex_32
# Generate server/emqx/api-key.bootstrap from this key/secret:
#   ./emqx/render-api-key-bootstrap.sh
EMQX_NODE_COOKIE=generate_with_openssl_rand_hex_32
MQTT_LAN_BIND_IP=192.168.1.16

# pgAdmin
PGADMIN_EMAIL=admin@smartair.local
PGADMIN_PASSWORD=changeme_pgadmin_password

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# API (server/api)
JWT_SECRET=generate_with_openssl_rand_hex_32
EMQX_MQTT_PASSWORD=changeme_sa_server_password

# Server
PORT=3000
LOG_LEVEL=info
BODY_LIMIT_BYTES=65536

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
PG_POOL_MAX=20
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=10000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT / sessions
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_REUSE_MARKER_SWEEP_INTERVAL_MS=3600000

# EMQX admin API
EMQX_API_URL=http://emqx:18083
EMQX_API_TIMEOUT_MS=5000

# EMQX MQTT bridge
EMQX_MQTT_URL=mqtt://emqx:1883
EMQX_MQTT_USER=sa-server
EMQX_MQTT_CLIENT_ID=sa-api-bridge
MQTT_PUBLISH_TIMEOUT_MS=5000
MQTT_PROVISION_RETRY_MS=5000

# OTA
OTA_PUBLIC_BASE_URL=https://minhnhat05.xyz
OTA_FILES_DIR=/ota-files

# Command timeouts (firmware ack; calibration ~180s)
COMMAND_SENT_TIMEOUT_SECONDS=420
COMMAND_PENDING_TIMEOUT_SECONDS=1800
COMMAND_TIMEOUT_SWEEP_INTERVAL_MS=30000

# Realtime stream
REALTIME_REPLAY_LIMIT=1000
REALTIME_HEARTBEAT_MS=25000
REALTIME_MAX_CLIENTS=1000
REALTIME_MAX_CLIENTS_PER_IP=10
REALTIME_EVENT_RETENTION_HOURS=24
REALTIME_EVENT_RETENTION_SWEEP_INTERVAL_MS=3600000

# Data retention
COMMAND_RETENTION_DAYS=30
DATA_RETENTION_SWEEP_INTERVAL_MS=3600000

# Blockchain incident intake (EIP-712 domain of the deployed AirSafetyLog)
# INCIDENT_DEPLOYMENT selects spec/incident/deployments/<name>.json (localhost|sepolia):
# address, chain ID and legacy domains then come from the generated spec module.
# AIR_SAFETY_LOG_ADDRESS is only needed without INCIDENT_DEPLOYMENT; if both are set
# they must match or the API refuses to start.
# The committed Sepolia deployment is the default runtime target.
INCIDENT_DEPLOYMENT=sepolia
AIR_SAFETY_LOG_ADDRESS=
# Old domains still accepted off-chain (outbox legacy_domain), comma-separated.
# Leave unset to use the deployment's legacyAddresses; set to an empty value once
# every device reported an empty incident queue.
# AIR_SAFETY_LOG_LEGACY_ADDRESSES=
INCIDENT_DOMAIN_NAME=AirSafetyLog
INCIDENT_DOMAIN_VERSION=1
INCIDENT_MAX_PAYLOAD_BYTES=4096
INCIDENT_CLOCK_SKEW_SECONDS=600

# Chain worker (docker compose --profile chain). The API also uses CHAIN_RPC_URL to
# refuse starting when the configured domain does not match the deployed contract.
CHAIN_RPC_URL=
# Dedicated relayer wallet holding only RELAYER_ROLE (never the admin wallet).
RELAYER_PRIVATE_KEY=
# Wallet holding DEVICE_MANAGER_ROLE (register/rotate/revoke device signers).
DEVICE_MANAGER_PRIVATE_KEY=
CHAIN_CONFIRMATIONS=3
CHAIN_POLL_INTERVAL_MS=5000
# Defaults to the deployment block from spec/incident/deployments.
# CHAIN_START_BLOCK=
CHAIN_MAX_ATTEMPTS=10
CHAIN_MAX_RETRY_AGE_HOURS=24
CHAIN_DOMAIN_CHECK=true

# Chain operations (docs/ops/CHAIN_WORKER_RUNBOOK.md).
# Alert after this many failed worker iterations in a row.
CHAIN_ALERT_FAILURE_STREAK=5
# Warn (once a day) when the relayer holds less than this; 0 disables.
CHAIN_RELAYER_MIN_BALANCE_ETH=0.05
CHAIN_BALANCE_CHECK_INTERVAL_MS=60000
# /api/health/chain turns 503 past these thresholds.
CHAIN_HEALTH_MAX_TICK_AGE_SECONDS=120
CHAIN_HEALTH_MAX_QUEUED_AGE_SECONDS=900
CHAIN_HEALTH_MAX_LAG_BLOCKS=50
# Optional Slack/Discord-compatible webhook for chain_ops_alerts.
OPS_ALERT_WEBHOOK_URL=
# Bearer token for /api/metrics/chain and the detailed /api/health/chain body.
# Unset in production = those operator views are disabled.
OPS_METRICS_TOKEN=

# CORS - comma-separated allowed origins
CORS_ORIGINS=https://minhnhat05.xyz
